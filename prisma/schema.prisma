// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "./generated"

  output = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─────────── ADMIN ───────────
model Admin {
  id       Int    @id @default(autoincrement())
  name     String
  username String @unique
  password String
  role     Role   @default(admin)

  stores Store[]
}

enum Role {
  admin
  superadmin
}

// ─────────── STORE ───────────
model Store {
  id            Int      @id @default(autoincrement())
  name          String
  address       String?
  vat           Float?
  serviceCharge Float?
  createAt      DateTime @default(now())

  adminId Int
  admin   Admin @relation(fields: [adminId], references: [id])

  tables    Table[]
  menus     Menu[]
  discounts Discount[]
  bills     Bill[]
  TableType TableType[]
  zone      Zone[]
}

// ─────────── TABLE TYPE ───────────
model TableType {
  id       Int    @id @default(autoincrement())
  nameType String
  minSeat  Int
  maxSeat  Int
  storeId  Int

  store  Store   @relation(fields: [storeId], references: [id])
  tables Table[]
}

enum statusTable {
  available
  in_use
  call_staff
  pay_bill
}

// ─────────── TABLE ───────────
model Table {
  id          Int         @id @default(autoincrement())
  tableName   String //add tablename
  storeId     Int
  tableTypeId Int
  zoneId      Int? //add zoneId
  status      statusTable @default(available)

  store     Store     @relation(fields: [storeId], references: [id])
  tableType TableType @relation(fields: [tableTypeId], references: [id])
  zone      Zone?     @relation(fields: [zoneId], references: [id]) // << ต้องมี zoneId
  orders    Order[]
}

model Zone {
  id       Int     @id @default(autoincrement())
  zoneName String
  storeId  Int
  table    Table[]
  store    Store   @relation(fields: [storeId], references: [id])
}

// ─────────── CATEGORY ───────────
model Category {
  id     Int     @id @default(autoincrement())
  name   String
  detail String?

  menus Menu[]
}

// ─────────── MENU ───────────
model Menu {
  id         Int     @id @default(autoincrement())
  name       String
  price      Float
  detail     String?
  discount   Float?
  netPrice   Float
  categoryId Int
  storeId    Int

  store      Store       @relation(fields: [storeId], references: [id])
  category   Category    @relation(fields: [categoryId], references: [id])
  orderUsers OrderUser[]
}

model MenuType {
  id      Int    @id @default(autoincrement())
  name    String
  storeId Int

  store Store @relation(fields: [storeId], references: [id])
}

// ─────────── DISCOUNT ───────────
model Discount {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  expiredAt DateTime
  maxCount  Int?
  startTime DateTime?
  endTime   DateTime?
  isActive  Boolean   @default(true)
  storeId   Int

  store  Store   @relation(fields: [storeId], references: [id])
  orders Order[]
}

// ─────────── ORDER ───────────
model Order {
  id          Int       @id @default(autoincrement())
  tableId     Int
  orderUserId Int?
  openTime    DateTime
  closeTime   DateTime?
  subtotal    Float?
  total       Float?
  discountId  Int?
  status      String?

  table      Table       @relation(fields: [tableId], references: [id])
  discount   Discount?   @relation(fields: [discountId], references: [id])
  orderUsers OrderUser[]
  bill       Bill?       @relation(fields: [billId], references: [id])
  billId     Int?
}

// ─────────── ORDER USER ───────────
model OrderUser {
  id       Int @id @default(autoincrement())
  menuId   Int
  quantity Int
  orderId  Int

  order Order @relation(fields: [orderId], references: [id])
  menu  Menu  @relation(fields: [menuId], references: [id])
}

// ─────────── BILL ───────────
model Bill {
  id      Int    @id @default(autoincrement())
  userId  Int?
  status  String
  total   Float
  orderId Int

  Store   Store?  @relation(fields: [storeId], references: [id])
  storeId Int?
  Order   Order[]
}
